[Unit]
Description=Xtend WiFi Auto Connect
After=network-online.target NetworkManager.service
Wants=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=6

[Service]
Type=simple
User=root
RuntimeDirectory=intergas-xtend-proxy
RuntimeDirectoryMode=0700

ExecStart=/usr/bin/env bash /opt/intergas-xtend-proxy/xtend-connect.sh

WorkingDirectory=/opt/intergas-xtend-proxy

Restart=always
RestartSec=10
TimeoutStopSec=15

# Logging
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false

[Install]
WantedBy=multi-user.target
